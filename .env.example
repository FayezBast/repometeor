# ---------------------------------------------------------------------------
# RepoMeteor example environment
#
#   cp .env.example .env && docker compose up --build
#
# The defaults below run the full stack in DEMO MODE with deterministic
# fictional data and no GitHub token. Nothing here is a real secret.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------

# development | staging | production. Production enables stricter defaults
# (no verbose error details in HTTP responses).
APP_ENV=development

# debug | info | warn | error
LOG_LEVEL=info

# When true the worker uses deterministic fictional data and never contacts
# GitHub. The web UI shows a permanent "Demo data" indicator.
# Set to false for live mode; GITHUB_TOKEN then becomes required.
DEMO_MODE=true

# --- Database ---------------------------------------------------------------

# PostgreSQL connection string. `postgres` is the Docker Compose service name.
# For a host-local database use e.g.
#   postgres://repometeor:repometeor@localhost:5432/repometeor?sslmode=disable
DATABASE_URL=postgres://repometeor:repometeor@postgres:5432/repometeor?sslmode=disable

# Connection pool bounds.
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT=10s
DATABASE_QUERY_TIMEOUT=8s

# --- API service ------------------------------------------------------------

API_HOST=0.0.0.0
API_PORT=8080

# Absolute, externally reachable base URLs. Used to build badge snippets,
# Atom feed links, canonical URLs and share images. No trailing slash.
API_PUBLIC_URL=http://localhost:8080
WEB_PUBLIC_URL=http://localhost:3000

# Browser-visible API base URL for the Next.js app. Must be reachable from the
# user's browser, which is not necessarily the same as the container network.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server-side base URL used by Next.js server components. Inside Docker this is
# the internal service address; leave empty to fall back to NEXT_PUBLIC_API_URL.
INTERNAL_API_URL=http://api:8080

# Comma-separated exact origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated CIDRs of proxies permitted to set X-Forwarded-For.
# Leave empty when the API is directly exposed: forwarded headers are then
# ignored and the socket peer address is used for rate limiting.
TRUSTED_PROXY_CIDRS=

# HTTP server limits.
API_READ_HEADER_TIMEOUT=5s
API_READ_TIMEOUT=15s
API_WRITE_TIMEOUT=30s
API_IDLE_TIMEOUT=60s
API_SHUTDOWN_TIMEOUT=15s
API_MAX_REQUEST_BYTES=65536

# --- GitHub -----------------------------------------------------------------

# Required when DEMO_MODE=false. A classic or fine-grained token with public
# read access is sufficient; RepoMeteor never needs write scopes.
# NEVER commit a real token.
GITHUB_TOKEN=

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_USER_AGENT=RepoMeteor/0.1
GITHUB_REQUEST_TIMEOUT=15s
GITHUB_MAX_RETRIES=4

# Concurrent GitHub requests. 1 is deliberately conservative and safe.
GITHUB_REQUEST_CONCURRENCY=1

# Stop scheduling non-essential collection once this percentage of the hourly
# rate-limit budget has been consumed. The remainder is reserved for
# user-submitted repositories and health checks.
GITHUB_RATE_BUDGET_PERCENT=60

# Cap on a single GitHub response body, in bytes.
GITHUB_MAX_RESPONSE_BYTES=4194304

# --- Worker scheduling ------------------------------------------------------

DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL=6h
SCORING_INTERVAL=15m
JOB_POLL_INTERVAL=2s
JOB_BATCH_SIZE=10
STALE_JOB_TIMEOUT=15m
WORKER_SHUTDOWN_TIMEOUT=30s

# Only repositories created/pushed inside these lookbacks are discovery
# candidates.
DISCOVERY_CREATED_LOOKBACK=720h
DISCOVERY_PUSHED_LOOKBACK=168h

# --- Tracking tiers ---------------------------------------------------------

HOT_REPOSITORY_LIMIT=500
HOT_POLL_INTERVAL=1h
WARM_REPOSITORY_LIMIT=2500
WARM_POLL_INTERVAL=4h
COLD_POLL_INTERVAL=12h

# Snapshot bucket width. Snapshots are deduplicated per repository per bucket.
SNAPSHOT_BUCKET_INTERVAL=1h

# --- Public limits ----------------------------------------------------------

PUBLIC_TRACKING_ENABLED=true
PUBLIC_TRACKING_RATE_LIMIT_PER_HOUR=10
API_READ_RATE_LIMIT_PER_MINUTE=120

# Optional in local/single-instance use. Set the same strong random value on
# every production API replica so hashed submission allowances are consistent.
RATE_LIMIT_KEY=

# --- Observability ----------------------------------------------------------

METRICS_ENABLED=true

# --- Web (Next.js) ----------------------------------------------------------

# Mirrors DEMO_MODE for build-time UI decisions. The API response is still the
# authoritative source of the demo indicator at runtime.
NEXT_PUBLIC_DEMO_MODE=true

# Public repository URL rendered in the footer and docs.
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/repometeor/repometeor

# --- CLI --------------------------------------------------------------------

# Overrides the CLI's built-in default API URL.
REPOMETEOR_API_URL=http://localhost:8080
